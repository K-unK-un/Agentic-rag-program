# ==================== 通义千问 / DashScope ====================
QWEN_MODEL_NAME=qwen3.8-max
STRATEGY_LLM_MODEL_NAME=qwen-turbo
# 在 https://dashscope.console.aliyun.com/ 申请
QWEN_API_KEY=sk-your-dashscope-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== 向量模型 ====================
EMBEDDINGS_MODEL_NAME=nomic-embed-text

# ==================== Neo4j ====================
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ==================== MySQL ====================
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
CONNECTION_STRING=mysql+pymysql://root:your_mysql_password@localhost:3306/rag_db

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0

# ==================== Agent RAG 新增配置 ====================

# 策略分析结果缓存时间（秒）
STRATEGY_CACHE_TTL=86400
# 进入 CrossEncoder 精排前的最大文档数（超出按 rrf/score 截断）
MAX_RERANK_DOCS=50
# 单路检索默认召回数
RETRIEVAL_TOP_K=20
# 返回给 Agent 的文档摘要最大字符数
SNIPPET_MAX_CHARS=200
